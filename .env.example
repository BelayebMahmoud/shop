# Copy to .env and adjust. Never commit .env (it is git-ignored).
# Ports on the host (change them if another program already uses one)
DB_PORT=5433
API_PORT=8000
WEB_PORT=8080

# Database
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=shop

# JSON Web Tokens: a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRE_MINUTES=30
